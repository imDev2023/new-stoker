{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "new-stoker-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "CLUSTER": "localnet",
    "RPC_URL": "http://127.0.0.1:8699",
    // The RPC browsers use; required on mainnet, where RPC_URL carries the provider key and must stay server-side.
    "PUBLIC_RPC_URL": "",
    "PUBLIC_API_URL": "http://localhost:8691",
    "WEB_ORIGIN": "http://localhost:3200",
    "LAUNCHLAB_PROGRAM": "DRay6fNdQ5J82H7xV6uq2aV3mNrUZ1J4PgSKsWgptcm6",
    "CPMM_PROGRAM": "DRaycpLY18LhpbydsBWbVJtxpNv9oXPgjRSfpF2bWpYb",
    "LOCK_PROGRAM": "DRay25Usp3YJAi7beckgpGUC7mGJ2cR1AVPxhYfwVCUX",
    // The Fee Collector (ADR 0004): revenue is swept to TREASURY_WALLET (a cold wallet or multisig vault; required on
    // mainnet) whenever the operations wallet holds more than 5 SOL, down to 1 SOL kept for fees. Fees worth under
    // 0.001 SOL wait for the next run.
    "TREASURY_WALLET": "",
    "SWEEP_THRESHOLD_LAMPORTS": "5000000000",
    "SWEEP_FLOAT_LAMPORTS": "1000000000",
    "COLLECT_MIN_LAMPORTS": "1000000",
    // The Creator Forward (ADR 0009) pays a Creator once what they are owed in one Quote Asset is worth 0.01 SOL.
    "CREATOR_FORWARD_MIN_LAMPORTS": "10000000",
    // The Graduation Fee (ADR 0015): 0.015 SOL's worth, withheld from the Creator's earnings on a coin once it graduates,
    // in the coin's Quote Asset at the Quote Registry's price, recorded on the Ledger against the graduation; "0" charges none.
    "GRADUATION_FEE_LAMPORTS": "15000000",
    // Copy Protection (#120, ADR 0012): nobody else may launch a coin with a launched coin's name, ticker or image for this long after it (seven days).
    "COPY_PROTECTION_SECONDS": "604800",
    // Reward Round rule changes apply no sooner than this after they are announced.
    "REWARD_RULES_LEAD_SECONDS": "86400",
    // Burn and Flywheel shares of revenue, in basis points, and how many top Launches the Flywheel buys.
    "BURN_SHARE_BPS": "6000",
    "FLYWHEEL_SHARE_BPS": "500",
    "FLYWHEEL_TOP_N": "10",
    // A buy-and-burn smaller than this waits for the budget to grow (0.01 SOL).
    "BURN_MIN_SPEND_LAMPORTS": "10000000",
    // What a referred curve trade pays its referrer, where the Quote Asset's GlobalConfig allows a share fee.
    "REFERRAL_SHARE_BPS": "50",
    // What one IP may do each minute without an API key: any requests, and prepare requests (transactions built for a wallet).
    "ANON_RATE_LIMIT_PER_MINUTE": "300",
    "ANON_PREPARE_RATE_LIMIT_PER_MINUTE": "25",
    // A Platform Fee or Creator Fee change applies no sooner than this after it is announced.
    "FEE_CHANGE_LEAD_SECONDS": "86400",
    // Permanent metadata (#44): ArDrive Turbo and the Arweave gateway coins' metadata URIs are built from. Locally the
    // stand-in from `pnpm stand-ins` plays both services and the gateway; mainnet uses https://upload.ardrive.io,
    // https://payment.ardrive.io and https://arweave.net (the defaults when unset), and ARWEAVE_TOP_UP_LAMPORTS 50000000.
    "TURBO_UPLOAD_URL": "http://127.0.0.1:8697",
    "TURBO_PAYMENT_URL": "http://127.0.0.1:8697",
    "ARWEAVE_GATEWAY_URL": "http://127.0.0.1:8697",
    "ARWEAVE_TOP_UP_LAMPORTS": "50000000",
    // From tools/localnet/.ledger/state.json after `pnpm localnet` (see CLAUDE.md); both are required.
    "PLATFORM_CONFIG": "",
    "PLATFORM_ADMIN": "",
    "PLATFORM_LOOKUP_TABLE": "",
    "GRADUATION_TARGET_LAMPORTS": "85000000000",
    // Raydium's crank migrates a sold-out curve within seconds; five minutes without it means something is wrong.
    "GRADUATION_ALERT_AFTER_SECONDS": "300",
    "POOL_BACKFILL_SECONDS": "900",
    // Prices, logos and the token list come from Jupiter's APIs as on mainnet; locally the stand-in from `pnpm stand-ins`
    // answers them from the mainnet snapshot the local chain quotes (tools/localnet/fixtures/mainnet). The tests' stack
    // uses "static" with the six quote cases' tables instead.
    "PRICE_SOURCE": "jupiter",
    "JUPITER_API_URL": "http://127.0.0.1:8698",
    // Every curve rule in one run of the Quote Registry refresh, so the chain's hundreds of Quote Assets are launchable
    // after one `curl /__scheduled`; production paces a first run over several (120 a run).
    "QUOTE_RULE_WRITES_MAX": "1000",
    // Buys paid with SOL route through the local chain's CPMM pools of SOL against USDC and JTO (tools/localnet
    // routes.ts), whose addresses never change and whose accounts it adds to the Platform Lookup Table. Mainnet uses
    // "jupiter".
    "SOL_ROUTE_SOURCE": "raydium-cpmm",
    "SOL_ROUTE_POOLS": "{\"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v\":\"5xFjKk9ca4K82RgiExkLGHZisPtGkLpWRQoSw3xfLazW\",\"jtojtomepa8beP8AuQc6eXt5FriJwfFMwQx2v2f9mCL\":\"FHDkeZECVQ2aWkLwhyZtdAsCXeQQop1uNkChDM6cGbYy\"}"
  },
  // Scheduled jobs: the graduation watch and the Metadata Upload every minute, the Quote Registry refresh (ADR 0005)
  // every five, the Fee Collector hourly. Locally, `wrangler dev --test-scheduled` runs them on GET /__scheduled?cron=<the cron>, and on a
  // bare GET all three.
  "triggers": { "crons": ["* * * * *", "*/5 * * * *", "15 * * * *", "*/10 * * * *", "45 * * * *"] },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://launchpad:launchpad@127.0.0.1:5462/launchpad"
    }
  ],
  "r2_buckets": [{ "binding": "METADATA_BUCKET", "bucket_name": "launchpad-metadata" }],
  // The devnet dress rehearsal (runbook, section 11): `wrangler deploy --env devnet`. Real devnet, our
  // own PlatformConfig and Platform Lookup Table there, file keypairs for the admin, operations wallet and Treasury.
  // RPC_URL is a secret here, since the provider's URL carries its key. Bindings and vars are not inherited by an
  // environment, so everything is named again.
  "env": {
    "devnet": {
      // The rebuild's own devnet rehearsal: its own Worker, database, bucket and PlatformConfig, never the original's
      // (`stoker-api-devnet` on api-devnet.stoker.markets belongs to imDev2023/Stoker-Markets). No custom domain until
      // the owner names one, so it answers on workers.dev.
      "name": "new-stoker-api-devnet",
      "workers_dev": true,
      "vars": {
        "CLUSTER": "devnet",
        // Browsers get the public endpoint, never the Worker's own RPC URL and its key.
        "PUBLIC_RPC_URL": "https://api.devnet.solana.com",
        // This Worker's own URL and the rebuild's devnet web origin, filled in when they are first deployed.
        "PUBLIC_API_URL": "",
        "WEB_ORIGIN": "",
        "LAUNCHLAB_PROGRAM": "DRay6fNdQ5J82H7xV6uq2aV3mNrUZ1J4PgSKsWgptcm6",
        "CPMM_PROGRAM": "DRaycpLY18LhpbydsBWbVJtxpNv9oXPgjRSfpF2bWpYb",
        "LOCK_PROGRAM": "DRay25Usp3YJAi7beckgpGUC7mGJ2cR1AVPxhYfwVCUX",
        // The rebuild's own devnet PlatformConfig, admin, Platform Lookup Table and Treasury. Never the original's
        // (J8wXws..., FGLT7W..., 3caF92..., CJbQFc...): two APIs on one PlatformConfig would each claim, sweep and
        // forward from the same operations wallet. `config()` refuses to start while they are empty.
        "PLATFORM_CONFIG": "",
        "PLATFORM_ADMIN": "",
        "PLATFORM_LOOKUP_TABLE": "",
        "TREASURY_WALLET": "",
        // The Graduation Target is mainnet's 85 SOL, so the site reads as it will on mainnet; a Graduation through
        // Raydium's crank was proven on 2026-10-03 with it at 0.5 SOL ("500000000"), which is the value to set again to
        // rehearse one. Devnet SOL is scarce, so the sweep is small: above 2.1 SOL down to 1.9.
        "GRADUATION_TARGET_LAMPORTS": "85000000000",
        "GRADUATION_ALERT_AFTER_SECONDS": "300",
        "POOL_BACKFILL_SECONDS": "900",
        "SWEEP_THRESHOLD_LAMPORTS": "2100000000",
        "SWEEP_FLOAT_LAMPORTS": "1900000000",
        "COLLECT_MIN_LAMPORTS": "100000",
        "CREATOR_FORWARD_MIN_LAMPORTS": "1000000",
        "GRADUATION_FEE_LAMPORTS": "15000000",
        // Copy Protection (#120, ADR 0012): nobody else may launch a coin with a launched coin's name, ticker or image for this long after it (seven days).
        "COPY_PROTECTION_SECONDS": "604800",
        "REWARD_RULES_LEAD_SECONDS": "86400",
        "BURN_SHARE_BPS": "6000",
        "FLYWHEEL_SHARE_BPS": "500",
        "FLYWHEEL_TOP_N": "10",
        // A tenth of mainnet's minimum, so the little revenue a rehearsal makes is enough for one buy-and-burn.
        "BURN_MIN_SPEND_LAMPORTS": "1000000",
        "REFERRAL_SHARE_BPS": "50",
        "ANON_RATE_LIMIT_PER_MINUTE": "300",
        "ANON_PREPARE_RATE_LIMIT_PER_MINUTE": "25",
        "FEE_CHANGE_LEAD_SECONDS": "86400",
        // The real Turbo and gateway: items within Turbo's free tier (about 105 KiB) land on Arweave. Turbo can't be
        // paid in devnet SOL, so the top-up is too small to leave the wallet and a larger image stays off Arweave.
        "TURBO_UPLOAD_URL": "https://upload.ardrive.io",
        "TURBO_PAYMENT_URL": "https://payment.ardrive.io",
        "ARWEAVE_GATEWAY_URL": "https://arweave.net",
        "ARWEAVE_TOP_UP_LAMPORTS": "5000",
        // Devnet has no Jupiter: SOL and devnet USDC are priced by hand, and nothing routes a buy paid with SOL.
        "PRICE_SOURCE": "static",
        "SOL_ROUTE_SOURCE": "none",
        "QUOTE_PRICES_USD": "{\"So11111111111111111111111111111111111111112\":\"150\",\"USDCoctVLVnvTXBEuP9s8hntucdJokbo17RwHuNXemT\":\"1\"}",
        "QUOTE_TOKEN_LIST": "{\"So11111111111111111111111111111111111111112\":{\"verified\":true,\"liquidityUsd\":2500000000},\"USDCoctVLVnvTXBEuP9s8hntucdJokbo17RwHuNXemT\":{\"verified\":true,\"liquidityUsd\":900000000}}"
      },
      "triggers": { "crons": ["* * * * *", "*/5 * * * *", "15 * * * *", "*/10 * * * *", "45 * * * *"] },
      // The rebuild's own devnet database (Hyperdrive id to come); the original's (2efc4f...) is the original's
      // database, whose migrations differ.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
      "r2_buckets": [{ "binding": "METADATA_BUCKET", "bucket_name": "new-stoker-metadata-devnet" }]
    }
    // No production environment here. Mainnet's `stoker-api` on api.stoker.markets is deployed from
    // imDev2023/Stoker-Markets until the owner's cutover (the map, issue #1); its addresses are in that repository's
    // apps/api/wrangler.jsonc. Never recreate or delete `stoker-api` from here: its OPERATIONS_KEY can never be put again.
  }
  // Secrets, set with `wrangler secret put` and in `.dev.vars` locally: OPERATIONS_KEY, HELIUS_WEBHOOK_SECRET,
  // MINT_KEY_SECRET, OPERATOR_TOKEN, and optionally JUPITER_API_KEY, ALERT_WEBHOOK_URL, and HELIUS_API_KEY together
  // with HELIUS_WEBHOOK_ID (the Indexer then adds each graduated pool to the Helius webhook through its API, never a
  // quote mint; without them the webhook's addresses are managed by hand).
}
